{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The JSON error of a failed loam command",
  "description": "With --json, a failed command prints this on stdout and nothing on stderr. kind and exit_code are stable. message is for a person to read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "exit_code", "message"],
      "properties": {
        "kind": { "enum": ["error", "invalid", "stale", "undo_clash", "link_path_missing", "contract_mismatch", "unknown_plot", "ambiguous"] },
        "exit_code": { "enum": [1, 2, 10, 11, 12, 13, 14, 15] },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "error" } } }, "then": { "properties": { "exit_code": { "const": 1 } } } },
        { "if": { "properties": { "kind": { "const": "invalid" } } }, "then": { "properties": { "exit_code": { "const": 2 } } } },
        {
          "if": { "properties": { "kind": { "const": "stale" } } },
          "then": {
            "properties": { "exit_code": { "const": 10 }, "details": { "$ref": "#/$defs/staleDetails" } },
            "required": ["details"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "undo_clash" } } },
          "then": {
            "properties": { "exit_code": { "const": 11 }, "details": { "$ref": "#/$defs/undoClashDetails" } },
            "required": ["details"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "link_path_missing" } } },
          "then": {
            "properties": { "exit_code": { "const": 12 }, "details": { "$ref": "#/$defs/linkPathMissingDetails" } },
            "required": ["details"]
          }
        },
        { "if": { "properties": { "kind": { "const": "contract_mismatch" } } }, "then": { "properties": { "exit_code": { "const": 13 } } } },
        { "if": { "properties": { "kind": { "const": "unknown_plot" } } }, "then": { "properties": { "exit_code": { "const": 14 } } } },
        { "if": { "properties": { "kind": { "const": "ambiguous" } } }, "then": { "properties": { "exit_code": { "const": 15 } } } }
      ]
    }
  },
  "$defs": {
    "staleDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_id", "items"],
      "properties": {
        "plot_id": { "$ref": "defs.json#/$defs/id" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "exists is false when the item is gone. A stale link or repo has link or repo with the current object. A stale name, what, why, or where has value, which is left out when it is empty.",
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "expected", "current", "exists"],
            "properties": {
              "item": { "type": "string", "minLength": 1 },
              "expected": { "type": "integer", "minimum": 0 },
              "current": { "type": "integer", "minimum": 0 },
              "exists": { "type": "boolean" },
              "value": { "type": "string" },
              "link": { "$ref": "defs.json#/$defs/link" },
              "repo": { "$ref": "defs.json#/$defs/repo" }
            }
          }
        }
      }
    },
    "linkPathMissingDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_id", "link_id", "path"],
      "properties": {
        "plot_id": { "$ref": "defs.json#/$defs/id" },
        "link_id": { "$ref": "defs.json#/$defs/id" },
        "path": { "description": "The absolute path, with ~ expanded.", "type": "string", "minLength": 1 }
      }
    },
    "undoClashDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "plot_id", "later_changes", "undo_would_write"],
      "properties": {
        "change_id": { "$ref": "defs.json#/$defs/changeId" },
        "plot_id": { "$ref": "defs.json#/$defs/id" },
        "later_changes": { "type": "array", "minItems": 1, "items": { "$ref": "defs.json#/$defs/change" } },
        "undo_would_write": { "type": "array", "items": { "$ref": "defs.json#/$defs/entry" } }
      }
    }
  }
}
